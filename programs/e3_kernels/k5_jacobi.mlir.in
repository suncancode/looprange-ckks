// K5 Jacobi iteration for [4 1; 1 3] z = (1, 2):  x <- (1 - y)/4,  y <- (2 - x)/3
func.func @f(%x0: f32 {secret.secret}, %y0: f32 {secret.secret}) -> f32 {
  %r:2 = affine.for %i = 0 to @N@ iter_args(%x = %x0, %y = %y0) -> (f32, f32) {
    %one = arith.constant 1.0 : f32
    %two = arith.constant 2.0 : f32
    %q = arith.constant 0.25 : f32
    %t = arith.constant 0.333333333 : f32
    %p = arith.subf %one, %y : f32
    %x2 = arith.mulf %p, %q : f32
    %s = arith.subf %two, %x : f32
    %y2 = arith.mulf %s, %t : f32
    affine.yield %x2, %y2 : f32, f32
  }
  return %r#1 : f32
}
