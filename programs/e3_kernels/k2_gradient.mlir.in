// K2 gradient step for 0.6 w^2 - w:  w <- w - 0.5 (1.2 w - 1)   (fixed point 1/1.2)
func.func @f(%w: f32 {secret.secret}) -> f32 {
  %r = affine.for %i = 0 to @N@ iter_args(%u = %w) -> (f32) {
    %g = arith.constant 1.2 : f32
    %one = arith.constant 1.0 : f32
    %eta = arith.constant 0.5 : f32
    %a = arith.mulf %u, %g : f32
    %b = arith.subf %a, %one : f32
    %c = arith.mulf %b, %eta : f32
    %y = arith.subf %u, %c : f32
    affine.yield %y : f32
  }
  return %r : f32
}
